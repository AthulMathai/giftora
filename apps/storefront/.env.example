# Copy to .env.local and fill in from the Supabase project settings (API section).
# Only the publishable (anon) key belongs in the storefront. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
