# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used ONLY by the Stripe webhook, payment setup and the notification worker,
# through the service-only svc_* database functions. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe → Developers → API keys (use test keys until launch)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → endpoint https://YOUR-SITE/api/stripe/webhook
# events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend). Sending domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Giftora <orders@giftora.ca>"

# WhatsApp Cloud API (Meta). Template must be approved in WhatsApp Manager.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NEW_ORDER=new_order_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# Protects /api/jobs/outbox (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
